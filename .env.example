# =============================================================
# LYKA Realty — Environment Configuration Template
# =============================================================

# Server Port & Host (Default: 3000 on 0.0.0.0)
PORT=3000
HOST=0.0.0.0

# Gemini API Key (Server-Side LLM Sovereign Advisory Concierge)
GEMINI_API_KEY=

# Public frontend URL for the existing Render backend
VITE_API_URL=https://your-render-service.onrender.com

# Ollama local provider (server-side only)
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Production Database (PostgreSQL / Render / Neon / Supabase / AWS RDS)
# If left blank, the application operates in DEMO_LOCAL mode with persistent JSON data.
DATABASE_URL=
# Alternatively, discrete PostgreSQL credentials:
PGHOST=
PGPORT=5432
PGDATABASE=lyka_realty
PGUSER=
PGPASSWORD=
PGSSL=true
